# ============================================================
# CorrEnem - Backend Environment Variables (.env.example)
# Copie este arquivo para .env e preencha os valores reais
# NUNCA envie o arquivo .env para o GitHub!
# ============================================================

# ─── Banco de Dados PostgreSQL ─────────────────────────────
# Obtenha essa string de conexão no painel do Railway > PostgreSQL > Variables
DATABASE_URL=postgresql://postgres:SUA_SENHA@host.railway.app:PORT/railway

# ─── OpenAI API (LLM para correção e recursos de IA) ──────
# Crie uma chave em https://platform.openai.com/api-keys
OPENAI_API_KEY=COLE_A_NOVA_CHAVE_OPENAI_AQUI
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini

# ─── E-mail via Brevo HTTP API (Porta 443) ─────────────────
# Crie conta em brevo.com, vá em Transacional > SMTP & API > Configurações de API
# Clique em "Gerar uma nova chave de API" e copie a chave gerada
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-xxxxxxxxxxxxxxxx

# E-mail do seu remetente (deve ser validado na conta Brevo)
BREVO_REMETENTE_EMAIL=seuemail@gmail.com
BREVO_REMETENTE_NOME=CorrEnem

# ─── Google OAuth ──────────────────────────────────────────
# Acesse console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=xxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx

# ─── CORS (origens permitidas) ────────────────────────────
# Em produção: URL do front-end hospedado (sem barra no final)
# Em desenvolvimento: http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,https://seu-site.vercel.app

# ─── Ambiente ────────────────────────────────────────────
# Use "production" em deploy, "development" para exibir códigos no console
ENVIRONMENT=production

# Opcional: exibir código de verificação no console (apenas dev)
SHOW_CONSOLE_CODES=false
